# ============================================================================
#  COMMAND CENTRE — Environment Configuration
#  Copy this file to ".env" and fill in the values you have.
#  The app runs fully in DEMO MODE without any keys — fill these in as you go.
# ============================================================================

# ---- Core app -------------------------------------------------------------
PORT=4000
# Session cookie signing secret. Change this to any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Dashboard login. On first run these seed the admin account.
# You can change the password later from the DB or by re-seeding.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ---- Feature flags --------------------------------------------------------
# When true, missing API keys will NOT block the app; integrations simulate
# results so you can test the full workflow locally. Set false in production.
DEMO_MODE=true

# ============================================================================
#  SOCIAL MEDIA  (see README for step-by-step key instructions)
# ============================================================================

# Facebook / Instagram — Meta Graph API
# https://developers.facebook.com/apps  → create app → Graph API
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_BUSINESS_ID=

# YouTube — Google Cloud Console → YouTube Data API v3
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# TikTok — https://developers.tiktok.com  (Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# ============================================================================
#  COMMUNICATIONS  (Twilio powers WhatsApp, SMS and Voice)
#  https://www.twilio.com/console
# ============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio SMS-capable number, e.g. +12025550123
TWILIO_SMS_NUMBER=
# Twilio WhatsApp sender, e.g. whatsapp:+14155238886 (sandbox) or your number
TWILIO_WHATSAPP_NUMBER=

# ============================================================================
#  GOOGLE CALENDAR  (appointment sync)
#  https://console.cloud.google.com/apis/library/calendar-json.googleapis.com
# ============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ---- Public booking base URL (used to generate booking links) -------------
PUBLIC_BASE_URL=http://localhost:4000
