# OpenClaw sales pack — environment variables
# Copy to .env and fill in real values. NEVER commit the filled-in .env.

# Firecrawl API key — powers the web-access skill (scrape + search).
# Get one at https://firecrawl.dev. Rotate immediately if it ever leaks.
FIRECRAWL_API_KEY=fc-your-key-here

# Optional: override the Firecrawl API base (defaults to the public v2 API).
# FIRECRAWL_API_BASE=https://api.firecrawl.dev/v2
